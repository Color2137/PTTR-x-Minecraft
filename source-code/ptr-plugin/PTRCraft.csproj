<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>PTRCraft</AssemblyName>
    <RootNamespace>PTRCraft</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- PTR's install (BepInEx and its generated interop live there). -->
    <PtrDir Condition="'$(PTR_DIR)' != ''">$(PTR_DIR)</PtrDir>
    <PtrDir Condition="'$(PtrDir)' == ''">E:\SteamLibrary\steamapps\common\Paint the Town Red</PtrDir>
    <BepCore>$(PtrDir)\BepInEx\core</BepCore>
    <Interop>$(PtrDir)\BepInEx\interop</Interop>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(BepCore)\BepInEx.Core.dll"><Private>false</Private></Reference>
    <Reference Include="$(BepCore)\BepInEx.Unity.IL2CPP.dll"><Private>false</Private></Reference>
    <Reference Include="$(BepCore)\BepInEx.Unity.Common.dll"><Private>false</Private></Reference>
    <Reference Include="$(BepCore)\Il2CppInterop.Runtime.dll"><Private>false</Private></Reference>
    <Reference Include="$(BepCore)\Il2CppInterop.Common.dll"><Private>false</Private></Reference>
    <Reference Include="$(BepCore)\0Harmony.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\Il2Cppmscorlib.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\Il2CppSystem.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\Il2CppSystem.Core.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\Assembly-CSharp.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\Assembly-CSharp-firstpass.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\UnityEngine.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\UnityEngine.CoreModule.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\UnityEngine.PhysicsModule.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\UnityEngine.UI.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\UnityEngine.UIModule.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\UnityEngine.IMGUIModule.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\UnityEngine.InputLegacyModule.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\UnityEngine.TextRenderingModule.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\UnityEngine.AnimationModule.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\UnityEngine.AudioModule.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\UnityEngine.ParticleSystemModule.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\UnityEngine.ImageConversionModule.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\Rewired_Core.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\Unity.TextMeshPro.dll"><Private>false</Private></Reference>
    <Reference Include="$(Interop)\Unity.Postprocessing.Runtime.dll"><Private>false</Private></Reference>
  </ItemGroup>
  <!-- After a build, copy the plugin into PTR's BepInEx/plugins (dotnet build -p:Deploy=true). -->
  <Target Name="DeployToPtr" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PtrDir)\BepInEx\plugins\PTRCraft" />
  </Target>
</Project>
